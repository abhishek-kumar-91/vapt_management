# Postgres connection string (Neon console → Connect; use the pooled host in production). Server-only; never prefix with NEXT_PUBLIC_.
# Use sslmode=verify-full for Neon (the pg driver warns about sslmode=require).
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=verify-full

# 32+ random characters, unique per environment. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
