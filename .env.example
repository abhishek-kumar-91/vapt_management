# The app's connection. Server-only; never prefix with NEXT_PUBLIC_.
# Connect as a login role that is a member of app_user (created by the migrations), NOT the table
# owner: row-level security only binds roles that don't own the tables. Create it once:
#   CREATE ROLE vapt_app LOGIN PASSWORD '<random>' IN ROLE app_user;
# Neon: use the pooled "-pooler" host and sslmode=verify-full.
DATABASE_URL=postgresql://vapt_app:vapt_app_local@localhost/vapt_dev

# The table owner, for migrations, pnpm db:seed, db:reset and user:create (never used by the app).
MIGRATION_DATABASE_URL=postgresql://localhost/vapt_dev

# Database used by `pnpm test`. It is wiped and re-migrated on every run, so never point it at real data.
# Local: createdb vapt_test
TEST_DATABASE_URL=postgresql://localhost/vapt_test

# 32+ random characters, unique per environment. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Public base URL, used to build links in emails (verify, invite, reset).
APP_URL=http://localhost:3000

# How emails leave the app (see docs/database-architecture.md §7):
#   log     queue + print to the server console + show the link on screen (development)
#   outbox  queue only; Super Admins copy links from Admin → Outbox (production until a provider is connected)
EMAIL_TRANSPORT=log

# Shared secret Vercel Cron sends to /api/cron/*. Generate like AUTH_SECRET.
CRON_SECRET=
